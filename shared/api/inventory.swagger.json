    "/api/v1/GetPart/{uuid}": {
      "get": {
        "summary": "GetPart Возвращает информацию о детали по её UUID",
        "operationId": "InventoryService_GetPart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetPartResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "Идентификатор запрашиваемой детали",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/api/v1/ListParts": {
      "post": {
        "summary": "ListParts Получает список деталей с возможностью фильтрации",
